// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────

enum Role {
  admin
  librarian
  student
}

enum SlotType {
  morning
  noon
  afternoon
  evening
}

enum BookingStatus {
  pending
  confirmed
  checked_in
  completed
  cancelled
  no_show
}

enum LoanStatus {
  requested
  issued
  returned
  overdue
  cancelled
  rejected
}

enum FineStatus {
  none
  unpaid
  paid
  waived
}

enum PaymentMethod {
  cash
  chalan
  online
}

// ─── Models ──────────────────────────────────────────────

model User {
  id           String    @id @default(uuid())
  name         String
  email        String    @unique
  studentId    String?   @unique
  passwordHash String
  role         Role      @default(student)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  bookings Booking[]
  loans    BookLoan[]

  @@map("users")
}

model Zone {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  color       String   @default("#4F46E5")
  rules       String[] @default([])
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  seats Seat[]

  @@map("zones")
}

model Seat {
  id         String  @id @default(uuid())
  seatNumber String
  zoneId     String
  isActive   Boolean @default(true)
  isOccupied Boolean @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  zone     Zone      @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  bookings Booking[]

  // Each seat number must be unique within its zone
  @@unique([zoneId, seatNumber])
  @@map("seats")
}

model Schedule {
  id     String   @id @default(uuid())
  date   DateTime @db.Date
  slot   SlotType
  isOpen Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bookings Booking[]

  // Exactly one schedule record per date + slot window
  @@unique([date, slot])
  @@map("schedules")
}

model Booking {
  id           String        @id @default(uuid())
  userId       String
  seatId       String
  scheduleId   String
  status       BookingStatus @default(confirmed)
  qrToken      String        @unique @default(uuid())
  bookedAt     DateTime      @default(now())
  checkedInAt  DateTime?
  checkedOutAt DateTime?
  cancelledAt  DateTime?
  cancelReason String?

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  seat     Seat     @relation(fields: [seatId], references: [id], onDelete: Cascade)
  schedule Schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  // Prevents double-booking: one booking per seat per schedule slot
  @@unique([seatId, scheduleId])
  // Fast lookup for active bookings by user
  @@index([userId, status])
  // Fast QR verification
  @@index([qrToken])
  @@map("bookings")
}

model Setting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt

  @@map("settings")
}

model Book {
  id              String     @id @default(uuid())
  title           String
  author          String
  isbn            String?    @unique
  barcode         String?    @unique
  category        String     @default("General")
  publisher       String?
  publicationYear Int?
  edition         String?
  description     String?
  coverImage      String?
  pdfUrl          String?
  totalCopies     Int        @default(1)
  availableCopies Int        @default(1)
  
  // Spatial Location Indexing (No floor needed)
  block           String     // e.g. "Block A", "Block B", "Main Hall"
  shelfNumber     String     // e.g. "Shelf 04", "Rack 12"
  rowNumber       String?    // e.g. "Row 2", "Slot 5"
  callNumber      String?    // e.g. "QA76.73.P98 2024"
  
  isActive        Boolean    @default(true)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  loans           BookLoan[]

  @@index([category])
  @@index([block, shelfNumber])
  @@index([barcode])
  @@map("books")
}

model BookLoan {
  id               String        @id @default(uuid())
  bookId           String
  userId           String
  borrowDate       DateTime      @default(now())
  dueDate          DateTime
  returnDate       DateTime?
  renewCount       Int           @default(0)
  status           LoanStatus    @default(requested)
  notes            String?
  approvedById     String?

  // Fine & Payment Settlement
  fineAmount       Float         @default(0)
  fineStatus       FineStatus    @default(none)
  paymentMethod    PaymentMethod?
  chalanNumber     String?
  finePaidAt       DateTime?
  fineReceivedById String?

  // Automated Email Notification Tracking
  warningEmailSent Boolean       @default(false)
  overdueEmailSent Boolean       @default(false)

  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  book             Book          @relation(fields: [bookId], references: [id], onDelete: Cascade)
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([bookId, status])
  @@index([fineStatus])
  @@map("book_loans")
}

