// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────

enum ZoneType {
  silent_desk
  group_study
  computer_lab
  open_reading
  conference_room
}

enum TableType {
  individual_cubicle
  circle_table
  meeting_table
  booth_pod
  workstation_bench
}

enum Role {
  super_admin
  admin
  librarian
  student
  faculty
}

enum ApprovalStatus {
  pending
  approved
  rejected
}

enum SuggestionStatus {
  pending
  approved
  fulfilled
  rejected
}

enum WaiverRequestStatus {
  pending
  approved
  rejected
}

/// Who a notice is meant for. `all` reaches every signed-in account.
enum AnnouncementAudience {
  all
  students
  faculty
  staff
}

/// How loudly a notice is presented.
enum AnnouncementPriority {
  info
  important
  urgent
}

/// What a member of the library is reporting.
enum ReportCategory {
  bug
  service
  facilities
  environment
  book
  other
}

enum ReportStatus {
  open
  in_review
  resolved
  dismissed
}

enum ReportPriority {
  low
  normal
  high
}

enum SlotType {
  morning
  noon
  afternoon
  evening
}

enum BookingStatus {
  pending
  confirmed
  checked_in
  completed
  cancelled
  no_show
}

enum LoanStatus {
  requested
  issued
  returned
  overdue
  cancelled
  rejected
}

enum FineStatus {
  none
  unpaid
  paid
  waived
}

enum PaymentMethod {
  cash
  chalan
  online
}

enum OtpPurpose {
  email_change
  password_change
  registration
}

// ─── Models ──────────────────────────────────────────────

model User {
  id           String    @id @default(uuid())
  name         String
  email        String    @unique
  studentId    String?   @unique
  passwordHash String
  role         Role      @default(student)
  isActive     Boolean   @default(true)

  /// Faculty-only identity fields. Null for students, librarians and admins.
  facultyId   String? @unique
  department  String?
  designation String?

  /// Registration email ownership proof. Null until the signup OTP is consumed.
  emailVerifiedAt DateTime?

  /// Accounts that need a human gate (faculty) start as pending.
  /// Self-serve student accounts and admin-created staff are approved on creation.
  approvalStatus  ApprovalStatus @default(approved)
  approvedById    String?
  approvedAt      DateTime?
  rejectionReason String?

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  bookings Booking[]
  loans    BookLoan[]
  otps     OtpVerification[]

  waiverRequestsMade     FineWaiverRequest[] @relation("WaiverRequester")
  waiverRequestsReceived FineWaiverRequest[] @relation("WaiverTarget")
  announcements          Announcement[]      @relation("AnnouncementAuthor")
  reports                Report[]            @relation("ReportAuthor")
  reportsHandled         Report[]            @relation("ReportHandler")
  bookSuggestions        BookSuggestion[]    @relation("SuggestionAuthor")
  bookSuggestionVotes    BookSuggestionVote[] @relation("SuggestionVoter")

  @@map("users")
}

/// Single-use verification code for a sensitive profile change.
/// Only the hash of the code is stored, never the code itself.
model OtpVerification {
  id         String     @id @default(uuid())
  userId     String
  purpose    OtpPurpose
  codeHash   String
  /// Target address for an email_change OTP; null for other purposes.
  newEmail   String?
  attempts   Int        @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime   @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@index([expiresAt])
  @@map("otp_verifications")
}

model Zone {
  id                 String    @id @default(uuid())
  name               String    @unique
  description        String?
  color              String    @default("#4F46E5")
  zoneType           ZoneType  @default(silent_desk)
  allowMultiSeat     Boolean   @default(false)
  maxSeatsPerBooking Int       @default(1)
  defaultTableType   TableType @default(individual_cubicle)
  rules              String[]  @default([])
  isActive           Boolean   @default(true)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  seats Seat[]

  @@map("zones")
}

model Seat {
  id            String    @id @default(uuid())
  seatNumber    String
  zoneId        String
  tableNumber   String?   // e.g. "Table G-1", "Desk Row 1", "Round Pod A"
  tableType     TableType @default(individual_cubicle)
  tableCapacity Int?      // Total seats at this table/cluster
  seatPosition  Int?      // Position / chair index at the table
  isActive      Boolean   @default(true)
  isOccupied    Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  zone         Zone          @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  bookings     Booking[]
  bookingSeats BookingSeat[]

  // Each seat number must be unique within its zone
  @@unique([zoneId, seatNumber])
  @@index([zoneId, tableNumber])
  @@map("seats")
}

model Schedule {
  id        String   @id @default(uuid())
  date      DateTime @db.Date
  slot      SlotType
  isOpen    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bookings Booking[]

  // Exactly one schedule record per date + slot window
  @@unique([date, slot])
  @@map("schedules")
}

model BookingSeat {
  id        String   @id @default(uuid())
  bookingId String
  seatId    String
  createdAt DateTime @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  seat    Seat    @relation(fields: [seatId], references: [id], onDelete: Cascade)

  @@unique([bookingId, seatId])
  @@index([seatId])
  @@map("booking_seats")
}

model Booking {
  id           String        @id @default(uuid())
  userId       String
  seatId       String?
  scheduleId   String
  guestCount   Int           @default(1)
  status       BookingStatus @default(confirmed)
  qrToken      String        @unique @default(uuid())
  bookedAt     DateTime      @default(now())
  checkedInAt  DateTime?
  checkedOutAt DateTime?
  cancelledAt  DateTime?
  cancelReason String?
  slotWarningEmailSent Boolean @default(false)

  // Cancellation / No-show Fine & Payment Settlement
  fineAmount       Float          @default(0)
  fineStatus       FineStatus     @default(none)
  paymentMethod    PaymentMethod?
  chalanNumber     String?
  finePaidAt       DateTime?
  fineReceivedById String?

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  seat         Seat?         @relation(fields: [seatId], references: [id], onDelete: SetNull)
  schedule     Schedule      @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  bookingSeats BookingSeat[]

  // Fast lookup for active bookings by user
  @@index([userId, status])
  // Fast QR verification
  @@index([qrToken])
  // Fast unpaid-dues lookup per student
  @@index([userId, fineStatus])
  @@map("bookings")
}

model Setting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt

  @@map("settings")
}

model Book {
  id              String     @id @default(uuid())
  title           String
  author          String
  isbn            String?    @unique
  barcode         String?    @unique
  category        String     @default("General")
  publisher       String?
  publicationYear Int?
  edition         String?
  description     String?
  coverImage      String?
  pdfUrl          String?
  totalCopies     Int        @default(1)
  availableCopies Int        @default(1)
  
  // Spatial Location Indexing (No floor needed)
  block           String     // e.g. "Block A", "Block B", "Main Hall"
  shelfNumber     String     // e.g. "Shelf 04", "Rack 12"
  rowNumber       String?    // e.g. "Row 2", "Slot 5"
  callNumber      String?    // e.g. "QA76.73.P98 2024"
  
  isActive        Boolean    @default(true)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  loans           BookLoan[]
  suggestions     BookSuggestion[]

  @@index([category])
  @@index([block, shelfNumber])
  @@index([barcode])
  @@map("books")
}

model BookLoan {
  id               String        @id @default(uuid())
  bookId           String
  userId           String
  borrowDate       DateTime      @default(now())
  dueDate          DateTime
  returnDate       DateTime?
  renewCount       Int           @default(0)
  status           LoanStatus    @default(requested)
  notes            String?
  approvedById     String?

  // Fine & Payment Settlement
  fineAmount       Float         @default(0)
  fineStatus       FineStatus    @default(none)
  paymentMethod    PaymentMethod?
  chalanNumber     String?
  finePaidAt       DateTime?
  fineReceivedById String?

  // Automated Email Notification Tracking
  warningEmailSent Boolean       @default(false)
  overdueEmailSent Boolean       @default(false)

  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  book             Book          @relation(fields: [bookId], references: [id], onDelete: Cascade)
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([bookId, status])
  @@index([fineStatus])
  @@map("book_loans")
}


/// A faculty member's petition to clear one outstanding fine on a student's
/// behalf. An admin decides it; approval waives the underlying fine record.
model FineWaiverRequest {
  id            String              @id @default(uuid())
  requestedById String
  targetUserId  String
  /// Exactly one of bookingId / loanId identifies the fine being petitioned.
  bookingId     String?
  loanId        String?
  /// Fine amount at request time, kept for the audit trail.
  amount        Float
  reason        String
  status        WaiverRequestStatus @default(pending)
  decidedById   String?
  decidedAt     DateTime?
  decisionNote  String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  requestedBy User @relation("WaiverRequester", fields: [requestedById], references: [id], onDelete: Cascade)
  targetUser  User @relation("WaiverTarget", fields: [targetUserId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([requestedById])
  @@index([targetUserId])
  @@index([bookingId])
  @@index([loanId])
  @@map("fine_waiver_requests")
}

/// A notice written by library staff and shown to the audience it targets.
/// Notices are never hard-deleted while they may still matter to a reader:
/// `isActive` retires one, and `expiresAt` retires it on a schedule.
model Announcement {
  id          String               @id @default(uuid())
  title       String
  /// Named `content`, not `body`: `requestValidator` treats a schema with a
  /// top-level `body` key as the wrap-the-request convention.
  content     String
  audience    AnnouncementAudience @default(all)
  priority    AnnouncementPriority @default(info)
  /// Pinned notices lead the feed regardless of date.
  isPinned    Boolean              @default(false)
  isActive    Boolean              @default(true)
  publishedAt DateTime             @default(now())
  /// Null means the notice stands until it is retired by hand.
  expiresAt   DateTime?
  createdById String
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  createdBy User @relation("AnnouncementAuthor", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([isActive, audience, publishedAt])
  @@index([isPinned])
  @@map("announcements")
}

/// A problem or request raised by a student or faculty member: a bug in the
/// system, a service issue, something broken in the building, and so on.
model Report {
  id          String         @id @default(uuid())
  reporterId  String
  category    ReportCategory @default(other)
  priority    ReportPriority @default(normal)
  status      ReportStatus   @default(open)
  subject     String
  description String
  /// Where in the library it happened; free text, optional.
  location    String?
  /// Staff reply, shown to the reporter.
  staffNote   String?
  handledById String?
  handledAt   DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  reporter  User  @relation("ReportAuthor", fields: [reporterId], references: [id], onDelete: Cascade)
  handledBy User? @relation("ReportHandler", fields: [handledById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([reporterId, status])
  @@index([category])
  @@map("reports")
}

/// A faculty member's recommendation for a book to be added to the library collection.
/// Other faculty members can upvote suggestions; top-voted books lead the acquisition queue.
model BookSuggestion {
  id            String           @id @default(uuid())
  userId        String
  title         String
  author        String
  publisher     String?
  edition       String?
  isbn          String?
  department    String?
  courseCode    String?
  reason        String?
  status        SuggestionStatus @default(pending)
  adminNotes    String?
  bookId        String?
  fulfilledAt   DateTime?
  fulfilledById String?
  upvoteCount   Int              @default(1)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  user          User                 @relation("SuggestionAuthor", fields: [userId], references: [id], onDelete: Cascade)
  book          Book?                @relation(fields: [bookId], references: [id], onDelete: SetNull)
  votes         BookSuggestionVote[]

  @@index([status])
  @@index([userId])
  @@index([upvoteCount(sort: Desc)])
  @@map("book_suggestions")
}

model BookSuggestionVote {
  id           String         @id @default(uuid())
  suggestionId String
  userId       String
  createdAt    DateTime       @default(now())

  suggestion   BookSuggestion @relation(fields: [suggestionId], references: [id], onDelete: Cascade)
  user         User           @relation("SuggestionVoter", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([suggestionId, userId])
  @@index([userId])
  @@map("book_suggestion_votes")
}
