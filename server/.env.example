# Server runtime
PORT=5000
NODE_ENV=production
TZ=Asia/Dhaka

# PostgreSQL (Docker Compose db service)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-this-strong-password
POSTGRES_DB=smart_library
DATABASE_URL=postgresql://postgres:change-this-strong-password@db:5432/smart_library

# Auth & Cookies
ACCESS_TOKEN_SECRET=replace-with-random-64-char-hex
REFRESH_TOKEN_SECRET=replace-with-random-64-char-hex
ACCESS_TOKEN_EXPIRES_IN=86400
REFRESH_TOKEN_EXPIRES_IN=604800
BCRYPT_SALT_ROUNDS=12
# Use "lax" when traffic is proxied same-origin via Vercel Next.js rewrites
COOKIE_SAME_SITE=lax
COOKIE_SECURE=true

# CORS / Frontend URL
FRONTEND_URL=https://your-vercel-app.vercel.app
CORS_ORIGINS=https://your-vercel-app.vercel.app

# Initial Super Admin Seed
SUPER_ADMIN_NAME=System Admin
SUPER_ADMIN_EMAIL=admin@library.com
SUPER_ADMIN_PASSWORD=change-this-admin-password

# Email (Resend or SMTP)
EMAIL_FROM=Smart Library <onboarding@resend.dev>
RESEND_API_KEY=
RESEND_FROM_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Cloudinary (Book cover uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

